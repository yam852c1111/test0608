            while (index < artworks.length) \{\
                // Determine current row size\
                const currentPatternSize = layoutPattern[patternIndex];\
                \
                // Get the block of artworks for this row\
                const rowItems = artworks.slice(index, index + currentPatternSize);\
                \
                // Create row container\
                const rowDiv = document.createElement('div');\
                \
                // Apply responsive column systems matching target photo layout grid\
                if (currentPatternSize === 1) \{\
                    rowDiv.className = "w-full grid grid-cols-1";\
                \} else if (currentPatternSize === 4) \{\
                    rowDiv.className = "w-full grid grid-cols-2 md:grid-cols-4 gap-1 md:gap-2";\
                \} else if (currentPatternSize === 2) \{\
                    rowDiv.className = "w-full grid grid-cols-1 md:grid-cols-2 gap-1 md:gap-2";\
                \}\
\
                rowItems.forEach(item => \{\
                    const card = createArtworkCard(item, currentPatternSize);\
                    rowDiv.appendChild(card);\
                \});\
\
                container.appendChild(rowDiv);\
                \
                // Advance pointers\
                index += rowItems.length;\
                patternIndex = (patternIndex + 1) % layoutPattern.length;\
            \}\
        \}\
\
        // Helper to output single image card with sharp margins\
        function createArtworkCard(item, rowSize) \{\
            const card = document.createElement('div');\
            \
            // Layout dimensions based on standard screen ratios\
            let heightClass = "h-[450px] md:h-[650px]"; // Default for large full-width images\
            if (rowSize === 4) \{\
                heightClass = "h-[200px] md:h-[280px]";\
            \} else if (rowSize === 2) \{\
                heightClass = "h-[350px] md:h-[480px]";\
            \}\
\
            card.className = `img-container w-full $\{heightClass\} bg-neutral-50 cursor-pointer transition-opacity duration-300 hover:opacity-95`;\
            card.onclick = () => openLightbox(item.src, item.title);\
\
            // Construct image with custom alignment parameters for detailed crops\
            const img = document.createElement('img');\
            img.src = item.src;\
            img.alt = item.title;\
            img.className = "w-full h-full object-cover";\
            \
            // Build absolute focus position mapping\
            let posX = "50%";\
            let posY = "50%";\
            if (item.alignX === "left") posX = "10%";\
            if (item.alignX === "right") posX = "90%";\
            if (item.alignY === "top") posY = "10%";\
            if (item.alignY === "bottom") posY = "90%";\
            \
            img.style.objectPosition = `$\{posX\} $\{posY\}`;\
            \
            card.appendChild(img);\
            return card;\
        \}\
\
        // Open Expanded Lightbox with fade animation\
        function openLightbox(src, title) \{\
