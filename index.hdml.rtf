        // Swaps input forms between Local Upload & Online URLs\
        function switchInputType(type) \{\
            const fileWrapper = document.getElementById('file-input-wrapper');\
            const urlWrapper = document.getElementById('url-input-wrapper');\
            \
            if (type === 'file') \{\
                fileWrapper.classList.remove('hidden');\
                urlWrapper.classList.add('hidden');\
            \} else \{\
                fileWrapper.classList.add('hidden');\
                urlWrapper.classList.remove('hidden');\
            \}\
        \}\
\
        // Handle File drag-and-drop or select locally\
        function handleFileSelect(e) \{\
            const file = e.target.files[0];\
            if (!file) return;\
\
            const reader = new FileReader();\
            reader.onload = function(event) \{\
                localFileBase64 = event.target.result;\
                const preview = document.getElementById('file-preview');\
                const dragText = document.getElementById('drag-text');\
                \
                preview.src = localFileBase64;\
                preview.classList.remove('hidden');\
                dragText.classList.add('hidden');\
            \};\
            reader.readAsDataURL(file);\
        \}\
\
        // Handle insertion of a new artwork card to database\
        function handleNewArtwork(e) \{\
            e.preventDefault();\
            \
            const inputType = document.querySelector('input[name="input_type"]:checked').value;\
            const title = document.getElementById('art-title').value;\
            const alignX = document.getElementById('art-align-x').value;\
            const alignY = document.getElementById('art-align-y').value;\
            \
            let finalSrc = "";\
